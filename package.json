{
    "name": "@bric/rex-page-events",
    "version": "0.0.1",
    "description": "REX module that records page, tab, and window lifecycle events with optional URL redaction via rex-lists.",
    "keywords": [
        "extension",
        "rex"
    ],
    "author": "Behavioral Research Innovation Center",
    "type": "module",
    "homepage": "https://github.com/bric-digital/rex-page-events",
    "bugs": {
        "url": "https://github.com/bric-digital/rex-page-events/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bric-digital/rex-page-events.git"
    },
    "exports": {
        "./browser": "./src/browser.mts",
        "./service-worker": "./src/service-worker.mts"
    },
    "scripts": {
        "build": "tsc",
        "lint": "eslint src",
        "pretest": "node tests/scripts/build-test-bundle.js",
        "test": "playwright test",
        "test:ci": "npm run pretest && playwright test --reporter=dot",
        "test:debug": "playwright test --debug",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:unit": "playwright test specs/"
    },
    "dependencies": {
        "@bric/rex-core": "github:bric-digital/rex-core",
        "@bric/rex-lists": "github:bric-digital/rex-lists",
        "@bric/rex-types": "github:bric-digital/rex-types"
    }
}
